{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/app.ts",
    "check": "bun run format:check && bun run lint",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:sign": "prisma db sign",
    "db:migration": "prisma migration plan --name",
    "db:migrate": "prisma db migrate --advance-ref db"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "prisma": "^7.10.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "7",
    "@wesleytodd/openapi": "^1.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  }
}
